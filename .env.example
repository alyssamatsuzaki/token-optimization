# Copy to .env. Tokop reads these once at startup and never writes them.
ANTHROPIC_API_KEY=            # required for a real demo recording
OPENROUTER_API_KEY=           # optional: adds more models to Compare
RECORD_BUDGET_USD=            # hard cap for `make record`; setting it is your consent to spend
DAILY_BUDGET_USD=5            # hard cap for live actions inside the app
TOKOP_MODE=replay             # live or replay
